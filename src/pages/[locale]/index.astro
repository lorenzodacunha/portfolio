---
// Home in English (/en/) and Spanish (/es/): the same component as the pt-BR home at /.
import HomePage from '../../components/pages/HomePage.astro';
import { LOCALES, DEFAULT_LOCALE } from '../../i18n';

export function getStaticPaths() {
  return LOCALES.filter((locale) => locale !== DEFAULT_LOCALE).map((locale) => ({ params: { locale } }));
}
---
<HomePage />

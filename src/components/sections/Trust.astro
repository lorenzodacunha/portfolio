---
// Numbers band below Sobre mim. Each number is a CSS counter driven by --n (design CSS, .count), which starts at
// --to; the script arms the count-up and runs it when the band comes into view.
import type { SiteContent } from '../../lib/types';
import { brandSafe } from '../../lib/text';
import { useT } from '../../i18n';

const t = useT(Astro.currentLocale);

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
---
<section id="numeros" class="trust" aria-label={t('trust.label')}>
  <div class="wrap">
    <ul class="trust__list" id="numeros-grade">
      {content.home.trust.map((item) => (
        <li class="trust__item"><strong class="trust__number count" style={`--to: ${item.value}`}><span class="sr">{item.value}</span></strong><span class="trust__label" set:html={brandSafe(item.label)}></span></li>
      ))}
    </ul>
  </div>
</section>

<script>
  // Numbers count up when the band comes into view. Without the script (or with reduced motion) they show the final value.
  // The count runs here, frame by frame, and not as a CSS animation of --n: Safari does not repaint the counter while a
  // custom property animates, so on iPhone the numbers sat at zero and jumped to the final value (Lorenzo, 28/10).
  // Same timing as the design: 1800 ms, ease-out (cubic-bezier(.22, 1, .36, 1)), 120 ms apart.
  const trust = document.querySelector<HTMLElement>('.trust');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const DURATION = 1800;
  const STAGGER = 120;
  const easeOut = (t: number) => 1 - Math.pow(1 - t, 4);

  const countUp = (el: HTMLElement, delay: number) => {
    const to = Number(getComputedStyle(el).getPropertyValue('--to')) || 0;
    let start = 0;
    const step = (now: number) => {
      if (!start) start = now + delay;
      const t = Math.min(1, Math.max(0, (now - start) / DURATION));
      el.style.setProperty('--n', String(Math.round(to * easeOut(t))));
      if (t < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };

  if (trust && !reduced && 'IntersectionObserver' in window) {
    trust.classList.add('is-armed');
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          trust.querySelectorAll<HTMLElement>('.count').forEach((el, i) => countUp(el, i * STAGGER));
          io.disconnect();
        }
      },
      { threshold: 0.4 },
    );
    io.observe(trust);
  }
</script>
